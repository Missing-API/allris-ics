{
  "name": "allris-ics",
  "version": "1.6.0",
  "description": "A middleware service that enhances ICS calendar feeds from Allris meeting management software by fetching detailed meeting information and formatting it for better readability.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Missing-API/allris-ics"
  },
  "bugs": {
    "url": "https://github.com/Missing-API/allris-ics/issues"
  },
  "homepage": "https://github.com/Missing-API/allris-ics#readme",
  "author": "Jan-Henrik Hempel <jan@schafe-vorm-fenster.de>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "next dev --webpack -p 3050",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint pages src",
    "test": "jest --maxWorkers=25% --testPathIgnorePatterns='.*\\.integration\\.ts$'",
    "test:watch": "jest --watch --maxWorkers=25% --testPathIgnorePatterns='.*\\.integration\\.ts$'",
    "test:ci": "jest --runInBand --testPathIgnorePatterns='.*\\.integration\\.ts$'",
    "test:integration": "jest --maxWorkers=25% --testMatch='**/*.integration.ts' --testTimeout=120000",
    "test:all": "jest --maxWorkers=25%",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "re2"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "@tree-sitter-grammars/tree-sitter-yaml",
      "core-js-pure",
      "iconv",
      "tree-sitter",
      "tree-sitter-json"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-import>eslint": "10",
        "eslint-plugin-jsx-a11y>eslint": "10",
        "eslint-plugin-react>eslint": "10",
        "react-debounce-input>react": "19",
        "react-inspector>react": "19"
      }
    }
  },
  "dependencies": {
    "@schafevormfenster/data-text-mapper": "^0.2.3",
    "@sparticuz/chromium": "^153.0.0",
    "axios": "^1.21.1",
    "cheerio": "^1.2.0",
    "iconv": "^3.0.1",
    "ics": "github:schafevormfenster/ics#d2dd3e7441b09ca7f68e15e93dd795bb93fa7577",
    "js-yaml": "^5.5.0",
    "next": "^16.4.6",
    "next-swagger-doc": "^0.5.0",
    "node-ical": "^0.15.3",
    "playwright-core": "^1.63.0",
    "re2": "^1.27.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "slugify": "^1.6.9",
    "swagger-ui-react": "^5.35.1",
    "url-regex-safe": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "6.0.3"
  }
}
